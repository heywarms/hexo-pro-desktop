{
  "name": "hexo-pro-desktop",
  "version": "2.1.0-beta.3",
  "description": "Hexo Pro \u684c\u9762\u5ba2\u6237\u7aef - \u4e00\u4e2a\u57fa\u4e8e Electron \u7684 Hexo \u535a\u5ba2\u7ba1\u7406\u5de5\u5177",
  "main": "src/main/bootstrap.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "cheerio": "1.0.0-rc.12"
  },
  "resolutions": {
    "cheerio": "1.0.0-rc.12"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dev:react": "echo '\u5f00\u53d1\u6a21\u5f0f\u4e0b\u76f4\u63a5\u4f7f\u7528\u5df2\u6784\u5efa\u7684\u524d\u7aef\u8d44\u6e90'",
    "build": "yarn build:react && yarn copy-core && yarn build:electron",
    "build:react": "yarn --cwd .. build",
    "build:electron": "electron-builder --publish never",
    "dist": "yarn build:react && yarn copy-core && electron-builder --publish never",
    "dist:all": "yarn build:react && yarn copy-core && electron-builder --mac --win --linux --publish never",
    "dist:mac": "yarn build:react && yarn copy-core && electron-builder --mac --publish never",
    "dist:win": "yarn build:react && yarn copy-core && electron-builder --win --publish never",
    "dist:linux": "yarn build:react && yarn copy-core && electron-builder --linux --publish never",
    "dist:publish": "yarn build:react && yarn copy-core && electron-builder --mac --win --linux --config.mac.forceCodeSigning=true --publish always",
    "dist:publish:current": "yarn build:react && yarn copy-core && electron-builder --config.mac.forceCodeSigning=true --publish always",
    "dist:publish:mac": "yarn build:react && yarn copy-core && electron-builder --mac --config.mac.forceCodeSigning=true --publish always",
    "dist:publish:win": "yarn build:react && yarn copy-core && electron-builder --win --config.mac.forceCodeSigning=true --publish always",
    "dist:publish:linux": "yarn build:react && yarn copy-core && electron-builder --linux --config.mac.forceCodeSigning=true --publish always",
    "pack": "electron-builder --dir",
    "copy-core": "node scripts/copy-hexo-pro.js",
    "postinstall": "electron-builder install-app-deps",
    "clean": "rimraf dist src/main/hexo-pro-core",
    "setup": "yarn install && yarn copy-core",
    "generate-icons": "node scripts/generate-icon.js",
    "create-test-icons": "node scripts/create-placeholder-icon.js",
    "create-working-icons": "node scripts/create-simple-icon.js",
    "setup-icons": "yarn generate-icons && yarn create-working-icons",
    "prepare:runtime": "node scripts/prepare-runtime.js",
    "prestart": "npm run prepare:runtime",
    "predev": "npm run prepare:runtime"
  },
  "keywords": [
    "hexo",
    "blog",
    "desktop",
    "electron",
    "management"
  ],
  "author": "heywarms",
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.7.9",
    "electron-builder": "^26.15.3",
    "rimraf": "^5.0.0",
    "tar": "7.5.22",
    "extract-zip": "2.0.1"
  },
  "dependencies": {
    "@seald-io/nedb": "^4.1.1",
    "ali-oss": "^6.23.0",
    "axios": "^1.7.0",
    "bcrypt-nodejs": "^0.0.3",
    "body-parser": "^1.20.2",
    "browser-sync": "^3.0.4",
    "cheerio": "^1.0.0",
    "chokidar": "^3.6.0",
    "circular-json": "^0.5.9",
    "connect-history-api-fallback": "^2.0.0",
    "cos-nodejs-sdk-v5": "^2.15.4",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.3.9",
    "express": "^4.18.2",
    "express-jwt": "^8.4.1",
    "extend": "^3.0.2",
    "flatted": "^3.2.7",
    "fs-extra": "^11.1.1",
    "fuse.js": "^7.0.0",
    "hexo": "^8.0.0",
    "hexo-deployer-git": "^4.0.0",
    "hexo-front-matter": "^4.2.1",
    "hexo-fs": "^5.0.0",
    "hexo-util": "^4.0.0",
    "iconv-lite": "^0.6.3",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "mime": "^3.0.0",
    "moment": "^2.30.1",
    "multer": "^1.4.5-lts.2",
    "qiniu": "^7.14.0",
    "serve-static": "^1.15.0",
    "uuid": "^10.0.0"
  },
  "build": {
    "appId": "com.hexo-pro.desktop",
    "productName": "Hexo Pro Desktop",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "heywarms",
        "repo": "hexo-pro",
        "releaseType": "draft"
      }
    ],
    "files": [
      "src/**/*",
      "assets/**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal",
            "arm64",
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "resources/runtime/darwin-${arch}",
          "to": "runtime/darwin-${arch}",
          "filter": [
            "**/*",
            "**/.*"
          ]
        }
      ],
      "mergeASARs": false
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "resources/runtime/win32-${arch}",
          "to": "runtime/win32-${arch}",
          "filter": [
            "**/*",
            "**/.*"
          ]
        }
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "resources/runtime/linux-${arch}",
          "to": "runtime/linux-${arch}",
          "filter": [
            "**/*",
            "**/.*"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "electronUpdaterCompatibility": ">=2.16",
    "beforePack": "scripts/before-pack.js",
    "afterPack": "scripts/verify-pack.js",
    "asarUnpack": [
      "src/main/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/templates",
        "to": "templates",
        "filter": [
          "default/**/*",
          "default/**/.*"
        ]
      }
    ]
  }
}
